APP_NAME=skilljudge-ai-eval-mock
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=14997

API_BEARER_TOKEN=skilljudge-local-token
PROCESSING_DELAY_SECONDS=3

RESULT_MODE=fixture
MOCK_MODEL_VERSION=mock-ai-eval-v1

LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.2
LLM_CHAT_PATH=/chat/completions
LLM_FALLBACK_TO_FIXTURE=false
LLM_MEDIA_MODE=inline
LLM_REPAIR_ENABLED=true
VIDEO_PREPROCESS_ENABLED=true
VIDEO_PREPROCESS_FPS=8
VIDEO_PREPROCESS_MAX_WIDTH=1280
VIDEO_PREPROCESS_CRF=30
VIDEO_PREPROCESS_AUDIO_BITRATE_KBPS=96
VIDEO_PREPROCESS_TIMEOUT_SECONDS=600
VIDEO_INLINE_MAX_MB=40

REDIS_URL=redis://:skilljudge12345@123.60.51.11:6379/0
JOB_RESULT_TTL_SECONDS=86400
VIDEO_CACHE_TTL_SECONDS=300
FAILED_VIDEO_CACHE_TTL_SECONDS=0
VIDEO_CACHE_DIR=/tmp/skilljudge-ai
WORKER_COUNT=2
MLLM_MAX_CONCURRENCY=2
DOWNLOAD_TIMEOUT_SECONDS=300
CLEANUP_INTERVAL_SECONDS=30
