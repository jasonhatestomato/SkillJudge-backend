APP_NAME=skilljudge-backend
APP_ENV=development
HTTP_PORT=8080

DB_HOST=192.168.0.146
DB_PORT=5432
DB_USER=skilljudge
DB_PASSWORD=skilljudge12345
DB_NAME=skilljudge_db
DB_SSLMODE=disable

REDIS_ADDR=192.168.0.146:6379
REDIS_PASSWORD=skilljudge12345
REDIS_DB=0

JWT_ISSUER=skilljudge
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_TTL=1h
JWT_REFRESH_TOKEN_TTL=168h
USER_CACHE_TTL=1h
