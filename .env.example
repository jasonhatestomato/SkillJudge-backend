APP_NAME=skilljudge-backend
APP_ENV=development
HTTP_HOST=127.0.0.1
HTTP_PORT=8080

DB_HOST=192.168.0.146
DB_PORT=5432
DB_USER=skilljudge
DB_PASSWORD=skilljudge12345
DB_NAME=skilljudge_db
DB_SSLMODE=disable

REDIS_ADDR=192.168.0.146:6379
REDIS_PASSWORD=skilljudge12345
REDIS_DB=0

JWT_ISSUER=skilljudge
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_TTL=1h
JWT_REFRESH_TOKEN_TTL=168h
USER_CACHE_TTL=1h
PERMISSION_CACHE_TTL=30m

AI_BASE_URL=
AI_ANALYSIS_PATH=/api/v1/analysis-jobs
AI_API_TOKEN=skilljudge-local-token
AI_REQUEST_TIMEOUT=15s
AI_POLL_INTERVAL=10s
AI_POLL_BATCH_SIZE=20
AI_CREATE_CONCURRENCY=5
AI_POLL_CONCURRENCY=5

STORAGE_PROVIDER=mock
STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:9000
STORAGE_BUCKET=skilljudge-8af9
STORAGE_REGION=cn-east-3
STORAGE_ENDPOINT=obs.cn-east-3.myhuaweicloud.com
STORAGE_IAM_ENDPOINT=https://iam.myhuaweicloud.com
STORAGE_ACCESS_KEY_ID=
STORAGE_ACCESS_KEY_SECRET=
STORAGE_STS_TTL=30m

BOOTSTRAP_ENABLED=false
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=Admin123456
INIT_ADMIN_REAL_NAME=系统管理员
